NODE_ENV=production
PORT=5000

MONGO_URI=
JWT_SECRET=                # lamba random string (32+ chars)

# Frontend URL(s), comma separated
CLIENT_URL=https://nex-contact.vercel.app

# ---- Email: EK option chuno ----
# Option A (recommended for production): Resend HTTPS API
RESEND_API_KEY=
EMAIL_FROM=NexContact <noreply@yourdomain.com>   # verified domain chahiye

# Option B: SMTP (Gmail App Password). Purane GMAIL_USER / GMAIL_PASS bhi chalenge
SMTP_USER=
SMTP_PASS=
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=465

CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Sirf local me, agar "querySrv ECONNREFUSED" aaye:
# DNS_SERVERS=8.8.8.8,1.1.1.1
